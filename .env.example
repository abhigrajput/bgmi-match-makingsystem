# =============================================================================
# .env.example
#
# VARIABLE NAMES ONLY. This file is committed; it must never contain a value.
# Copy it to .env.local (git-ignored) and fill values in there.
#
#   cp .env.example .env.local
#
# Phase 1 note: nothing in the application reads these yet. They are declared
# now so the surface area of what this system will need is visible up front.
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase -- browser-exposed
#
# The NEXT_PUBLIC_ prefix means Next.js inlines these into the client bundle.
# Only the project URL and the anon key belong here. The anon key is designed to
# be public and is safe only because row-level security constrains it, so RLS
# must be enabled before this project handles real accounts (Phase 2).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# -----------------------------------------------------------------------------
# Supabase -- server-only
#
# The service role key bypasses row-level security completely. It must never
# carry a NEXT_PUBLIC_ prefix, never be imported into a client component, and
# never be read outside lib/ or scripts/.
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string. Used only by the Supabase CLI for
# migrations and by scripts/ for bulk seeding -- not by the running app.
SUPABASE_DB_URL=


# -----------------------------------------------------------------------------
# ML service (Python / FastAPI)
#
# Base URL of the scoring service. If unset or unreachable, Next.js falls back
# to the rule-based scorer in lib/ -- see docs/architecture.md section 4.
# An empty value is a supported configuration, not a misconfiguration.
# -----------------------------------------------------------------------------
ML_SERVICE_URL=

# Shared secret sent by Next.js on every call to the ML service, so the service
# can reject requests that did not come from the web tier.
ML_SERVICE_API_KEY=

# Request timeout in milliseconds. Bounds how long a matchmaking request can
# wait before giving up on the ML path and scoring locally instead.
ML_SERVICE_TIMEOUT_MS=

# Set to "true" to skip the ML path entirely and always use the rule-based
# scorer. Useful for local development and for reproducing the fallback path
# without taking the service down.
ML_SERVICE_DISABLED=


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Absolute origin of the deployed app, used for redirects and callback URLs.
NEXT_PUBLIC_APP_URL=

# development | production
NODE_ENV=
